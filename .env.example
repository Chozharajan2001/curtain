# Meta API: locate (muse-spark-1.3) + mask (sam-3.1). Same key, model per call.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# SAM 3.1 runs on the Meta API too — no extra key. (S6)
# Baseten: attacker only (meta-models/muse-spark-open-1026). URL from your deployment. (S7)
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL=meta-models/muse-spark-open-1026
