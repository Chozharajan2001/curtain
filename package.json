{
  "name": "curtain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build-corpus": "node scripts/build-corpus.mjs",
    "count:planted": "node scripts/count-planted.mjs",
    "skeleton": "node scripts/skeleton.mjs",
    "locate": "node --env-file-if-exists=.env scripts/locate.mjs && node scripts/score-locate.mjs corpus/out/locate.json",
    "score": "node scripts/score-locate.mjs",
    "cost": "node scripts/cost.mjs",
    "mask-images": "node scripts/mask-images.mjs",
    "mask:check": "node scripts/mask-check.mjs",
    "mask:sam": "node --env-file-if-exists=.env scripts/mask-sam.mjs && node scripts/score-sam.mjs corpus/out/sam.json",
    "attack": "node --env-file-if-exists=.env scripts/attack.mjs && node scripts/score-attack.mjs corpus/out/attack.json",
    "blur-probe": "node --env-file-if-exists=.env scripts/blur-probe.mjs",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "build-screen": "node scripts/build-screen.mjs",
    "build-marker": "node scripts/build-marker.mjs",
    "build-hard": "node scripts/build-hard.mjs",
    "variance": "node scripts/variance.mjs",
    "measure:styled": "node scripts/measure-styled.mjs",
    "key:styled": "node scripts/measure-styled.mjs && node scripts/build-styled-key.mjs",
    "locate:styled": "node --env-file-if-exists=.env scripts/locate.mjs runs/locate-set-styled.json && node scripts/score-locate.mjs corpus/out/locate.json corpus/key/v1-styled.json",
    "mask:sweep": "node scripts/margin-sweep.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
